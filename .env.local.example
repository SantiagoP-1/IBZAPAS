# Copiar a .env.local y completar con los datos reales del proyecto Supabase.
# Ninguno de estos valores va al repositorio (.env* esta en .gitignore).

# Panel > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo se usa en scripts que corren en tu máquina (seed, uploads).
# NUNCA exponer en código de cliente ni commitear.
SUPABASE_SERVICE_ROLE_KEY=

# Número de WhatsApp de IB ZAPAS en formato internacional, sin "+" ni espacios.
# Argentina requiere el "9" de celular en los links wa.me:
# 54 (país) + 9 (celular AR) + código de área sin 0 + número sin 15.
# Número real del negocio: (2266) 510373 -> 5492266510373 (ya cargado en .env.local).
NEXT_PUBLIC_WHATSAPP_NUMBER=
